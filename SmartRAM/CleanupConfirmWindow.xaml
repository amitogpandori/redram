<Window x:Class="SmartRAM.CleanupConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RED RAM · Confirm cleanup" Style="{StaticResource RedRamWindow}"
        Height="620" Width="860" MinHeight="460" MinWidth="680" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="RED RAM // CONFIRM" Style="{StaticResource Eyebrow}" Foreground="{StaticResource RedBrush}"/>
            <TextBlock x:Name="Headline" Style="{StaticResource H1}" FontSize="22" TextWrapping="Wrap"/>
            <TextBlock Text="Files go to the Windows Recycle Bin — nothing is deleted permanently. You can restore them from the Recycle Bin until you empty it." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <WrapPanel x:Name="Chips" Grid.Row="1" Margin="0,12,0,10"/>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" Margin="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="90" SortMemberPath="Bytes"/>
                    <DataGridTextColumn Header="KIND" Binding="{Binding Kind}" Width="120"/>
                    <DataGridTextColumn Header="FOLDER" Binding="{Binding Folder}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock x:Name="Notes" Grid.Row="3" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <CheckBox x:Name="AckCheck" VerticalAlignment="Center" Checked="Ack_Changed" Unchecked="Ack_Changed">
                <TextBlock Text="I've reviewed this list — move these files to the Recycle Bin." TextWrapping="Wrap"/>
            </CheckBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource Primary}" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
