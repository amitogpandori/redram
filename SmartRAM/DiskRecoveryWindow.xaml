<Window x:Class="SmartRAM.DiskRecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RED RAM · Disk Recovery" Height="720" Width="1040" MinHeight="620" MinWidth="820" Background="#06111F" WindowStartupLocation="CenterOwner">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Disk Recovery" Foreground="White" FontSize="30" FontWeight="Bold"/><TextBlock Text="Choose a drive and use one-click recovery. RED RAM never formats or initializes the source drive." Foreground="#9AB0C9" Margin="0,5,0,16"/></StackPanel>
<WrapPanel Grid.Row="1"><ComboBox x:Name="DriveBox" Width="180" Height="36" Margin="0,0,10,0"/><Button x:Name="ScanButton" Content="Recover &amp; Repair Automatically" Padding="18,8" Click="Scan_Click"/><Button x:Name="RepairButton" Content="Advanced repair" Padding="18,8" Margin="10,0,0,0" IsEnabled="False" Click="Repair_Click"/><Button x:Name="ImageButton" Content="Create Recovery Image" Padding="18,8" Margin="10,0,0,0" Click="Image_Click"/><Button x:Name="FilesButton" Content="Recover Files" Padding="18,8" Margin="10,0,0,0" Click="Files_Click"/><Button x:Name="StructureButton" Content="Deep Partition Scan" Padding="18,8" Margin="10,0,0,0" Click="Structure_Click"/><Button x:Name="CancelButton" Content="Cancel" Padding="18,8" Margin="10,0,0,0" IsEnabled="False" Click="Cancel_Click"/></WrapPanel>
<Border Grid.Row="2" Background="#0B1B2E" BorderBrush="#16476A" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,18,0,18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="Headline" Text="No drive scanned yet." Foreground="#00F58A" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="Details" Foreground="#D6E2F0" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="Scan evidence" Foreground="White" FontWeight="Bold" Margin="0,20,0,5"/><TextBlock x:Name="Evidence" Foreground="#9AB0C9" TextWrapping="Wrap"/><TextBlock Text="Windows filesystem scan" Foreground="White" FontWeight="Bold" Margin="0,20,0,5"/><TextBox x:Name="Output" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#071525" Foreground="#D6E2F0" BorderBrush="#16476A" MinHeight="180" VerticalScrollBarVisibility="Auto"/></StackPanel></ScrollViewer></Border>
<TextBlock Grid.Row="3" x:Name="Status" Foreground="#9AB0C9" Text="RED RAM never formats or initializes a damaged drive automatically."/>
</Grid></Window>