<Window x:Class="SmartRAM.StorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RED RAM · Storage Cleaner" Style="{StaticResource RedRamWindow}"
        Height="840" Width="1360" MinHeight="680" MinWidth="1080" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid>
            <StackPanel>
                <TextBlock Text="RED RAM // STORAGE" Style="{StaticResource Eyebrow}" Foreground="{StaticResource RedBrush}"/>
                <TextBlock Text="Storage Cleaner" Style="{StaticResource H1}"/>
                <TextBlock Text="See what fills your drive, tick what you don't need, and send it to the Recycle Bin. Windows, apps and AppData stay locked." Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="DriveBox" Width="250" Margin="0,0,8,0" ToolTip="Drive to scan"/>
                <Button x:Name="ScanButton" Style="{StaticResource Primary}" Content="⟳  Scan drive" Margin="0,0,8,0" Click="Scan_Click"/>
                <Button x:Name="PauseButton" Content="Pause" Margin="0,0,8,0" IsEnabled="False" Click="Pause_Click"/>
                <Button x:Name="StopButton" Content="Stop" IsEnabled="False" Click="Stop_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== Scan options ===== -->
        <Border Grid.Row="1" Style="{StaticResource SubtleCard}" Margin="0,14,0,0" Padding="12,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="TYPES" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ToggleButton x:Name="VideosFilter" Style="{StaticResource Chip}" Content="Videos" IsChecked="True"/>
                <ToggleButton x:Name="ImagesFilter" Style="{StaticResource Chip}" Content="Images" IsChecked="True"/>
                <ToggleButton x:Name="AudioFilter" Style="{StaticResource Chip}" Content="Audio" IsChecked="True"/>
                <ToggleButton x:Name="DocumentsFilter" Style="{StaticResource Chip}" Content="Documents" IsChecked="True"/>
                <ToggleButton x:Name="ArchivesFilter" Style="{StaticResource Chip}" Content="Archives" IsChecked="True"/>
                <ToggleButton x:Name="OtherFilter" Style="{StaticResource Chip}" Content="Other" IsChecked="True" Margin="0,0,18,0"/>
                <TextBlock Text="SIZE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SizePresetBox" Width="140" Margin="0,0,8,0" SelectionChanged="SizePreset_Changed">
                    <ComboBoxItem Content="Any size" IsSelected="True"/>
                    <ComboBoxItem Content="Under 10 MB"/>
                    <ComboBoxItem Content="10–100 MB"/>
                    <ComboBoxItem Content="100–500 MB"/>
                    <ComboBoxItem Content="500 MB–1 GB"/>
                    <ComboBoxItem Content="1–5 GB"/>
                    <ComboBoxItem Content="5–10 GB"/>
                    <ComboBoxItem Content="10 GB+"/>
                    <ComboBoxItem Content="Custom"/>
                </ComboBox>
                <TextBox x:Name="MinSizeBox" Text="0" Width="64" IsEnabled="False" ToolTip="Minimum size in MB"/>
                <TextBlock Text="–" Foreground="{StaticResource TextMutedBrush}" Margin="6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="MaxSizeBox" Width="64" IsEnabled="False" ToolTip="Maximum size in MB (empty = no limit)"/>
                <TextBlock Text="MB" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,18,0"/>
                <CheckBox x:Name="SimilarCheck" Content="Find similar photos" IsChecked="True" ToolTip="Compares pictures visually. Turn off for a faster scan."/>
            </WrapPanel>
        </Border>

        <!-- ===== Progress + drive map ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" Style="{StaticResource Mono}" Text="Ready — pick a drive and press Scan." TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="SafeSummary" Style="{StaticResource Mono}" Foreground="{StaticResource GreenBrush}" Margin="16,0,0,0"/>
                    <TextBlock x:Name="DuplicateSummary" Style="{StaticResource Mono}" Foreground="{StaticResource CyanBrush}" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" Style="{StaticResource Mono}" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
            </Grid>
            <TextBlock x:Name="CurrentScanItem" Grid.Row="2" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
        </Grid>

        <!-- ===== Body: categories | list | preview ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="4,0,4,10">
                        <TextBlock Text="DRIVE MAP" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="DriveUsageText" Text="—" Style="{StaticResource Mono}" Foreground="{StaticResource TextBrush}"/>
                        <Border CornerRadius="4" Background="{StaticResource Surface3Brush}" Height="10" Margin="0,6,0,0" ClipToBounds="True">
                            <Grid x:Name="DriveMap"/>
                        </Border>
                        <TextBlock x:Name="DriveMapLegend" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="CATEGORIES" Style="{StaticResource Eyebrow}" Margin="4,4,4,6"/>
                    <ListBox x:Name="CategoryList" Grid.Row="2" SelectionChanged="Category_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ToolTip="{Binding Hint}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.RowSpan="2" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CountText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"/>
                                    <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="3" CornerRadius="1.5" Background="{StaticResource Surface3Brush}" Margin="0,4,0,2">
                                        <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="1.5" Background="{Binding Brush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- File list -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,12,14,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ViewTitle" Text="All files" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="ViewSubtitle" Text="Run a scan to see your files." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="230" Margin="0,0,8,0">
                                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search file name or folder"/>
                                <TextBlock Text="⌕  Search name or folder…" IsHitTestVisible="False" Foreground="{StaticResource TextDimBrush}" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ComboBox x:Name="ShowBox" Width="150" Margin="0,0,8,0" SelectionChanged="Filter_Changed" ToolTip="Which files to show">
                                <ComboBoxItem Content="All files" IsSelected="True"/>
                                <ComboBoxItem Content="Removable only"/>
                                <ComboBoxItem Content="Ticked only"/>
                                <ComboBoxItem Content="Locked only"/>
                            </ComboBox>
                            <ComboBox x:Name="ViewModeBox" Width="110" SelectionChanged="ViewMode_Changed" ToolTip="Row density">
                                <ComboBoxItem Content="Comfort" IsSelected="True"/>
                                <ComboBoxItem Content="Compact"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Grid.Row="1" Margin="14,0,14,8">
                        <Button Content="Select all" Style="{StaticResource Ghost}" Click="SelectVisible_Click" ToolTip="Tick every removable file in this view"/>
                        <Button Content="None" Style="{StaticResource Ghost}" Click="ClearSelection_Click" ToolTip="Untick every file in this view"/>
                        <Button Content="Invert" Style="{StaticResource Ghost}" Click="Invert_Click" ToolTip="Flip the ticks in this view"/>
                        <Button x:Name="SmartButton" Content="✦  Smart select ▾" Style="{StaticResource Accent}" Padding="12,6" Margin="6,0,10,0" Click="SmartSelect_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✓  All safe junk (old temp files)" Tag="junk" Click="SmartItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="⧉  Duplicates · keep RED RAM's pick" Tag="dup-best" Click="SmartItem_Click"/>
                                    <MenuItem Header="⧉  Duplicates · keep newest copy" Tag="dup-newest" Click="SmartItem_Click"/>
                                    <MenuItem Header="⧉  Duplicates · keep oldest copy" Tag="dup-oldest" Click="SmartItem_Click"/>
                                    <MenuItem Header="◐  Similar photos · keep largest of each set" Tag="similar" Click="SmartItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="▲  In this view · larger than 1 GB" Tag="gt1g" Click="SmartItem_Click"/>
                                    <MenuItem Header="▲  In this view · larger than 100 MB" Tag="gt100m" Click="SmartItem_Click"/>
                                    <MenuItem Header="⌛  In this view · not changed for 1 year" Tag="old1y" Click="SmartItem_Click"/>
                                    <MenuItem Header="⌛  In this view · not changed for 6 months" Tag="old6m" Click="SmartItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="☑  Tick highlighted rows (Space)" Tag="hl-on" Click="SmartItem_Click"/>
                                    <MenuItem Header="☐  Untick highlighted rows" Tag="hl-off" Click="SmartItem_Click"/>
                                    <MenuItem Header="✕  Clear all ticks everywhere" Tag="clear-all" Click="SmartItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <CheckBox x:Name="ShowKeepersCheck" Content="Show kept originals" VerticalAlignment="Center" Checked="KeeperView_Changed" Unchecked="KeeperView_Changed" ToolTip="In Duplicates, also list the copy RED RAM recommends keeping"/>
                        <TextBlock Text="Tip: Shift+click a box to tick a range · Space ticks highlighted rows · Del removes ticked" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </WrapPanel>
                    <DataGrid x:Name="FilesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionMode="Extended" MouseDoubleClick="FilesGrid_DoubleClick" SelectionChanged="FilesGrid_SelectionChanged" Sorting="FilesGrid_Sorting" Margin="2,0,2,2">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open file" Click="OpenFile_Click"/>
                                <MenuItem Header="Show in File Explorer" Click="Explorer_Click"/>
                                <MenuItem Header="Properties" Click="Properties_Click"/>
                                <MenuItem Header="Copy path" Click="CopyPath_Click"/>
                                <Separator/>
                                <MenuItem Header="Tick highlighted rows" Tag="hl-on" Click="SmartItem_Click"/>
                                <MenuItem Header="Untick highlighted rows" Tag="hl-off" Click="SmartItem_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox Click="HeaderCheck_Click" ToolTip="Tick / untick every removable file in this view" IsThreeState="False"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" Click="RowCheck_Click" HorizontalAlignment="Center" ToolTip="{Binding CheckTip}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="NAME" Width="260" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Item.Path}">
                                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SIZE" Width="120" SortMemberPath="Bytes">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Size}" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right"/>
                                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource Surface3Brush}" Margin="0,3,0,0">
                                                <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="1.5" Background="{Binding CategoryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="64"/>
                            <DataGridTextColumn Header="MODIFIED" Binding="{Binding ModifiedAt, StringFormat=yyyy-MM-dd}" Width="96" SortMemberPath="ModifiedAt"/>
                            <DataGridTemplateColumn Header="SAFETY" Width="112" SortMemberPath="SafetyRank">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="8,2" Background="{Binding SafetySoftBrush}" BorderBrush="{Binding SafetyBrush}" BorderThickness="1" HorizontalAlignment="Left" ToolTip="{Binding Item.Reason}">
                                            <TextBlock Text="{Binding SafetyLabel}" Foreground="{Binding SafetyBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FOLDER" Binding="{Binding Folder}" Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="GROUP" Binding="{Binding Group}" Width="110"/>
                            <DataGridTextColumn Header="NOTE" Binding="{Binding Status}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Nothing here yet." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Preview -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="PREVIEW" Style="{StaticResource Eyebrow}"/>
                        <Border Height="170" CornerRadius="10" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,4,0,12" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="PreviewPlaceholder" Text="Select a file to preview it" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PreviewName" Text="—" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewSize" Style="{StaticResource Readout}" FontSize="20" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,8"/>
                        <Border x:Name="PreviewSafetyBadge" CornerRadius="9" Padding="8,3" BorderThickness="1" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,6">
                            <TextBlock x:Name="PreviewSafetyText" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="PreviewReason" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="LOCATION" Style="{StaticResource Eyebrow}" Margin="0,12,0,2"/>
                        <TextBlock x:Name="PreviewFolder" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="DETAILS" Style="{StaticResource Eyebrow}" Margin="0,12,0,2"/>
                        <TextBlock x:Name="PreviewDetails" Style="{StaticResource Mono}" FontSize="11.5" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewGroup" Style="{StaticResource Muted}" Foreground="{StaticResource CyanBrush}" FontSize="12" Margin="0,8,0,0"/>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Button Content="Open" Margin="0,0,4,6" Click="OpenFile_Click"/>
                            <Button Content="Show in folder" Margin="4,0,0,6" Click="Explorer_Click"/>
                            <Button Content="Copy path" Margin="0,0,4,0" Click="CopyPath_Click"/>
                            <Button Content="Properties" Margin="4,0,0,0" Click="Properties_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Selection bar ===== -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="SelectionDot" Width="10" Height="10" Fill="{StaticResource TextDimBrush}" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock x:Name="SelectionText" Text="0 files ticked · 0 B" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="SelectionDetail" Text="Tick files in the list, or use Smart select." Style="{StaticResource Hint}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center" x:Name="DeleteProgressPanel" Visibility="Collapsed">
                    <TextBlock x:Name="DeleteProgressText" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="DeleteProgress" Minimum="0" Maximum="100" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open Recycle Bin" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="OpenRecycleBin_Click" ToolTip="Changed your mind? Restore files from the Windows Recycle Bin."/>
                    <Button x:Name="CleanSafeButton" Style="{StaticResource Accent}" Content="✓  Clean safe junk" Margin="0,0,8,0" IsEnabled="False" Click="CleanSafe_Click" ToolTip="Only old, unused Windows temp files. Nothing personal."/>
                    <Button x:Name="DeleteButton" Style="{StaticResource Primary}" Content="🗑  Review &amp; move to Recycle Bin" IsEnabled="False" Click="Delete_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
