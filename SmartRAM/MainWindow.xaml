<Window x:Class="SmartRAM.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RED RAM" FontFamily="Segoe UI Variable Text" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Height="800" Width="1540" MinHeight="700" MinWidth="1280" Background="#06111F" WindowStartupLocation="CenterScreen">
<Window.Resources>
<DropShadowEffect x:Key="Glow" Color="#00F58A" BlurRadius="22" ShadowDepth="0" Opacity=".5"/>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#0B1B2E"/><Setter Property="BorderBrush" Value="#16476A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="16"/></Style>
<Style TargetType="Button"><Setter Property="Foreground" Value="#EAF4FF"/><Setter Property="Background" Value="#10263F"/><Setter Property="BorderBrush" Value="#28618D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#174266"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Green" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#087A43"/><Setter Property="BorderBrush" Value="#00F58A"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Effect" Value="{StaticResource Glow}"/></Style>
<Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="18,12"/></Style>
</Window.Resources>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
<Border Background="#071525" BorderBrush="#123552" BorderThickness="0,0,1,0"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="8,10,0,28"><TextBlock Text="▣" Foreground="#00F58A" FontSize="25" Margin="0,0,10,0"/><TextBlock Text="RED RAM" Foreground="White" FontSize="21" FontWeight="Bold"/></StackPanel><StackPanel Grid.Row="1"><Button Style="{StaticResource Nav}" Background="#086EE8" BorderBrush="#1E9BFF" Content="⌂   Dashboard" Click="Dashboard_Click"/><Button Style="{StaticResource Nav}" Content="⚡   Optimize" Click="OptimizeNav_Click"/><Button Style="{StaticResource Nav}" Content="◫   Analysis" Click="AnalysisNav_Click"/><Button Style="{StaticResource Nav}" Content="☷   Processes" Click="ProcessesNav_Click"/><Button Style="{StaticResource Nav}" Content="▰   Storage" Click="Storage_Click"/><Button Style="{StaticResource Nav}" Content="▤   File Organizer" Click="Organizer_Click"/><Button Style="{StaticResource Nav}" Content="✚   Disk Recovery" Click="Recovery_Click"/><Button Style="{StaticResource Nav}" Content="⚙   Settings" Click="SettingsNav_Click"/></StackPanel><StackPanel Grid.Row="2" Margin="8"><TextBlock Text="●  RED RAM" Foreground="#00F58A"/><TextBlock Text="v0.8" Foreground="#91A8C2" Margin="22,4,0,0"/></StackPanel></Grid></Border>
<Border Grid.Column="1" Margin="12,18,0,18" CornerRadius="16" BorderBrush="#123552" BorderThickness="1" Background="#071525" ToolTip="Reserved for future unobtrusive sponsor content"/><Grid Grid.Column="2" Margin="22,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="200"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="RED RAM" Foreground="White" FontSize="31" FontWeight="Bold"/><TextBlock Text="Adaptive memory intelligence for your PC" Foreground="#9AB0C9" FontSize="14"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><CheckBox x:Name="StartupCheck" Content="Start with Windows" Foreground="#D6E2F0" Margin="0,0,18,0" Checked="Startup_Changed" Unchecked="Startup_Changed"/><Button x:Name="StartSmartRamButton" Style="{StaticResource Green}" Content="▶  Start RED RAM" Margin="0,0,8,0" Click="StartSmartRam_Click"/><Button x:Name="StopSmartRamButton" Content="■  Stop RED RAM" Margin="0,0,8,0" Click="StopSmartRam_Click"/><Button x:Name="UpdateButton" Content="↻  Check for updates" Click="Update_Click"/></StackPanel></Grid>
<Border Grid.Row="1" Background="#0A2B22" BorderBrush="#00F58A" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ActiveDot" Text="●" Foreground="#00F58A" FontSize="17" Margin="0,0,8,0"/><TextBlock x:Name="ActiveStatusText" Text="RED RAM is ACTIVE — live monitoring and memory intelligence are running." Foreground="#DDF9EB" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border><UniformGrid Grid.Row="2" Columns="4" Margin="0,14,0,14"><Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="PHYSICAL RAM" Foreground="#9AB0C9"/><TextBlock x:Name="RamText" Text="—" Foreground="White" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="RAM USED" Foreground="#9AB0C9"/><TextBlock x:Name="UsedText" Text="—" Foreground="White" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="MEMORY PRESSURE" Foreground="#9AB0C9"/><TextBlock x:Name="PressureText" Text="—" Foreground="#00F58A" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TOTAL MEMORY CAPACITY" Foreground="#9AB0C9"/><TextBlock x:Name="VirtualText" Text="—" Foreground="#38BDF8" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Physical RAM → Windows commit capacity" Foreground="#7890AA" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,9,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Live memory · last 5 minutes" Foreground="White" FontSize="16" FontWeight="SemiBold"/><StackPanel Grid.Row="1"><TextBlock x:Name="ChartStats" Foreground="#9AB0C9" Margin="0,5,0,0"/><TextBlock Text="Shows physical RAM pressure over the last 5 minutes. Higher values mean Windows has less free physical memory." Foreground="#7890AA" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><Canvas x:Name="Chart" Grid.Row="2" Margin="0,10,0,0" SizeChanged="Chart_SizeChanged"/></Grid></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Memory pressure &amp; paging" Foreground="White" FontSize="16" FontWeight="SemiBold"/><Canvas x:Name="PagingChart" Grid.Row="1" Margin="0,10,0,0" SizeChanged="Chart_SizeChanged"/><StackPanel Grid.Row="2"><TextBlock x:Name="PagingStats" Foreground="#9AB0C9" TextWrapping="Wrap"/><TextBlock Text="Shows disk paging activity. Spikes mean Windows is reading or writing memory pages through storage; sustained activity can indicate memory pressure." Foreground="#7890AA" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Grid></Border></Grid>
<UniformGrid Grid.Row="4" Columns="4" Margin="0,14"><Button x:Name="ApplyButton" Style="{StaticResource Green}" Content="⚡  Optimize PC" Margin="0,0,9,0" Click="Apply_Click"/><Button x:Name="AnalyzeButton" Content="▣  Analyze PC" Margin="0,0,9,0" Click="Analyze_Click"/><Button x:Name="BenchmarkButton" Content="◉  Benchmark" Margin="0,0,9,0" Click="Benchmark_Click"/><Button x:Name="BaselineButton" Content="▥  Before / After" Click="Baseline_Click"/></UniformGrid>
<Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="PC Profile" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="ProfileText" Foreground="#D6E2F0" Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock x:Name="RecommendationTitle" Foreground="#FFC21C" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock x:Name="RecommendationText" Foreground="#D6E2F0" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Memory health &amp; live diagnostics" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="DiagnosticsText" Grid.Row="1" Foreground="#D6E2F0" Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock x:Name="IntelligenceText" Grid.Row="2" Foreground="#00F58A" Margin="0,7,0,5" TextWrapping="Wrap"/><ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="Top memory users" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,3"/><TextBlock x:Name="ProcessesText" Foreground="#9AB0C9" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid></Border></Grid>
<Grid Grid.Row="6" Margin="0,13,0,0"><TextBlock x:Name="StatusText" Text="Monitoring…" Foreground="#9AB0C9" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="AfterButton" Content="Measure After" Margin="0,0,8,0" Click="After_Click"/><Button Content="File Organizer" Margin="0,0,8,0" Click="Organizer_Click"/><Button Content="Storage Cleaner" Margin="0,0,8,0" Click="Storage_Click"/><Button Content="Windows Settings" Margin="0,0,8,0" Click="MemorySettings_Click"/><Button Content="Restore Previous" Click="Restore_Click"/></StackPanel></Grid>
</Grid><Border Grid.Column="3" Margin="0,18,12,18" CornerRadius="16" BorderBrush="#123552" BorderThickness="1" Background="#071525" ToolTip="Reserved for future unobtrusive sponsor content"/></Grid></Window>