<Window x:Class="SmartRAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RED RAM" Style="{StaticResource RedRamWindow}"
        Height="820" Width="1540" MinHeight="720" MinWidth="1280" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="8,0,0,26">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentGradientBrush}" Effect="{StaticResource RedGlow}" Margin="0,0,10,0">
                            <TextBlock Text="R" Foreground="White" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="RED RAM" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="MEMORY · STORAGE · RECOVERY" Style="{StaticResource Eyebrow}" FontSize="9.5" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MONITOR" Style="{StaticResource Eyebrow}" Margin="8,0,0,6"/>
                    <Button Style="{StaticResource NavActive}" Content="⌂   Dashboard" Click="Dashboard_Click"/>
                    <Button Style="{StaticResource Nav}" Content="⚡   Optimize" Click="OptimizeNav_Click"/>
                    <Button Style="{StaticResource Nav}" Content="◫   Analysis" Click="AnalysisNav_Click"/>
                    <Button Style="{StaticResource Nav}" Content="☷   Processes" Click="ProcessesNav_Click"/>
                    <TextBlock Text="TOOLS" Style="{StaticResource Eyebrow}" Margin="8,16,0,6"/>
                    <Button Style="{StaticResource Nav}" Content="▰   Storage Cleaner" Click="Storage_Click"/>
                    <Button Style="{StaticResource Nav}" Content="▤   File Organizer" Click="Organizer_Click"/>
                    <Button Style="{StaticResource Nav}" Content="✚   Disk Recovery" Click="Recovery_Click"/>
                    <TextBlock Text="SYSTEM" Style="{StaticResource Eyebrow}" Margin="8,16,0,6"/>
                    <Button Style="{StaticResource Nav}" Content="⚙   Settings" Click="SettingsNav_Click"/>
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource SubtleCard}" Padding="10,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" Effect="{StaticResource GreenGlow}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="RED RAM" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Text="v0.10.0" Style="{StaticResource Mono}" FontSize="11" Margin="15,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="12,18,0,18" CornerRadius="14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#0A0C12" ToolTip="Reserved for future unobtrusive sponsor content"/>

        <!-- ===== Main ===== -->
        <Grid Grid.Column="2" Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="210"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="RED RAM // DASHBOARD" Style="{StaticResource Eyebrow}" Foreground="{StaticResource RedBrush}"/>
                    <TextBlock Text="Memory Command Center" Style="{StaticResource H1}" FontSize="28"/>
                    <TextBlock Text="Adaptive memory intelligence for your PC" Style="{StaticResource Muted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="StartupCheck" Content="Start with Windows" Margin="0,0,16,0" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                    <Button x:Name="StartSmartRamButton" Style="{StaticResource Primary}" Content="▶  Start RED RAM" Margin="0,0,8,0" Click="StartSmartRam_Click"/>
                    <Button x:Name="StopSmartRamButton" Content="■  Stop" Margin="0,0,8,0" Click="StopSmartRam_Click"/>
                    <Button x:Name="UpdateButton" Content="↻  Check for updates" Click="Update_Click"/>
                </StackPanel>
            </Grid>

            <Border x:Name="ActiveBanner" Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource GreenBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ActiveDot" Text="●" Foreground="{StaticResource GreenBrush}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ActiveStatusText" Text="RED RAM is ACTIVE — live monitoring and memory intelligence are running." Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <UniformGrid Grid.Row="2" Columns="4" Margin="0,14,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="PHYSICAL RAM" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="RamText" Text="—" Style="{StaticResource Readout}"/>
                        <Border Height="2" CornerRadius="1" Background="{StaticResource AccentGradientBrush}" Margin="0,8,40,0" Opacity=".7"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="RAM USED" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="UsedText" Text="—" Style="{StaticResource Readout}"/>
                        <Border Height="2" CornerRadius="1" Background="{StaticResource MeterGradientBrush}" Margin="0,8,40,0" Opacity=".7"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="MEMORY PRESSURE" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="PressureText" Text="—" Style="{StaticResource Readout}" Foreground="{StaticResource RedBrush}" Effect="{StaticResource RedGlow}"/>
                        <Border Height="2" CornerRadius="1" Background="{StaticResource RedBrush}" Margin="0,8,40,0" Opacity=".7"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TOTAL MEMORY CAPACITY" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="VirtualText" Text="—" Style="{StaticResource Readout}" FontSize="21" Foreground="{StaticResource CyanBrush}"/>
                        <TextBlock Text="Physical RAM → Windows commit capacity" Style="{StaticResource Hint}" FontSize="10"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Live memory · last 5 minutes" Style="{StaticResource H2}"/>
                            <TextBlock Text="● PRESSURE %" Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource RedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1">
                            <TextBlock x:Name="ChartStats" Style="{StaticResource Mono}" FontSize="11.5" Margin="0,4,0,0"/>
                            <TextBlock Text="Physical RAM pressure over the last 5 minutes. Higher means Windows has less free physical memory." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Canvas x:Name="Chart" Grid.Row="2" Margin="0,10,0,0" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Paging activity" Style="{StaticResource H2}"/>
                            <TextBlock Text="● PAGES/S" Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="PagingChart" Grid.Row="1" Margin="0,10,0,0" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/>
                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="PagingStats" Style="{StaticResource Mono}" FontSize="11.5" TextWrapping="Wrap"/>
                            <TextBlock Text="Spikes mean Windows is moving memory pages through storage; sustained activity can indicate memory pressure." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="4" Columns="4" Margin="0,14">
                <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="⚡  Optimize PC" Padding="14,11" Margin="0,0,10,0" Click="Apply_Click"/>
                <Button x:Name="AnalyzeButton" Style="{StaticResource Accent}" Content="▣  Analyze PC" Padding="14,11" Margin="0,0,10,0" Click="Analyze_Click"/>
                <Button x:Name="BenchmarkButton" Content="◉  Benchmark" Padding="14,11" Margin="0,0,10,0" Click="Benchmark_Click"/>
                <Button x:Name="BaselineButton" Content="▥  Before / After" Padding="14,11" Click="Baseline_Click"/>
            </UniformGrid>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="PC Profile" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="ProfileText" Foreground="{StaticResource TextBrush}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RecommendationTitle" Foreground="{StaticResource AmberBrush}" FontWeight="Bold" Margin="0,8,0,2" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RecommendationText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Memory health &amp; live diagnostics" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="DiagnosticsText" Grid.Row="1" Foreground="{StaticResource TextBrush}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="IntelligenceText" Grid.Row="2" Foreground="{StaticResource GreenBrush}" Margin="0,7,0,5" TextWrapping="Wrap"/>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="TOP MEMORY USERS" Style="{StaticResource Eyebrow}" Margin="0,4,0,3"/>
                                <TextBlock x:Name="ProcessesText" Style="{StaticResource Mono}" FontSize="11.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="6" Margin="0,13,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Monitoring…" Style="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AfterButton" Content="Measure After" Margin="0,0,8,0" Click="After_Click"/>
                    <Button Content="File Organizer" Style="{StaticResource Ghost}" Margin="0,0,4,0" Click="Organizer_Click"/>
                    <Button Content="Storage Cleaner" Style="{StaticResource Ghost}" Margin="0,0,4,0" Click="Storage_Click"/>
                    <Button Content="Windows Settings" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="MemorySettings_Click"/>
                    <Button Content="Restore Previous" Style="{StaticResource Danger}" Click="Restore_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Column="3" Margin="0,18,12,18" CornerRadius="14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#0A0C12" ToolTip="Reserved for future unobtrusive sponsor content"/>
    </Grid>
</Window>
