<Window x:Class="SmartRAM.FileOrganizerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RED RAM · File Organizer" Height="760" Width="1180" MinHeight="650" MinWidth="980" Background="#07111F" FontFamily="Segoe UI Variable Text">
<Window.Resources><Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#10263F"/><Setter Property="BorderBrush" Value="#28618D"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/></Style><Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#087A43"/><Setter Property="BorderBrush" Value="#00F58A"/></Style></Window.Resources>
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="File Organizer" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Turn one messy folder into a clean library. Preview everything before RED RAM creates folders or moves files." Foreground="#9AB0C9" Margin="0,4,0,0"/></StackPanel>
<Grid Grid.Row="1" Margin="0,18,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SourceBox" Height="34" VerticalContentAlignment="Center" ToolTip="Folder containing files to organize"/><Button Grid.Column="1" Content="Choose source" Click="Source_Click"/><TextBox x:Name="DestinationBox" Grid.Column="2" Height="34" VerticalContentAlignment="Center" ToolTip="One master destination folder"/><Button Grid.Column="3" Content="Choose destination" Click="Destination_Click"/></Grid>
<WrapPanel Grid.Row="2" Margin="0,4,0,12"><TextBlock Text="Structure" Foreground="#9AB0C9" VerticalAlignment="Center"/><ComboBox x:Name="StructureBox" Width="190" Margin="8,0,18,0"><ComboBoxItem Content="Type → Year → Month" IsSelected="True"/><ComboBoxItem Content="Year → Month → Type"/><ComboBoxItem Content="Year → Month"/><ComboBoxItem Content="Type only"/><ComboBoxItem Content="Device → Year → Month"/></ComboBox><TextBlock Text="Date" Foreground="#9AB0C9" VerticalAlignment="Center"/><ComboBox x:Name="DateBox" Width="145" Margin="8,0,18,0"><ComboBoxItem Content="Best available" IsSelected="True"/><ComboBoxItem Content="Created"/><ComboBoxItem Content="Modified"/></ComboBox><RadioButton x:Name="MoveRadio" Content="Move" IsChecked="True" Foreground="White" Margin="0,0,12,0"/><RadioButton x:Name="CopyRadio" Content="Copy" Foreground="White" Margin="0,0,18,0"/><CheckBox x:Name="SubfoldersCheck" Content="Include subfolders" IsChecked="True" Foreground="White"/></WrapPanel>
<Border Grid.Row="3" Background="#10263F" BorderBrush="#28618D" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#087A43" CornerRadius="10" Padding="10,5" VerticalAlignment="Top"><TextBlock Text="1 → 2 → 3" Foreground="White" FontWeight="Bold"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="How to organize your files" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="1. Choose the folder containing your files and where they should go.  2. Click Preview — nothing is changed.  3. Review the list, then click Start organizing. Use Stop at any time; Undo is available after a move." Foreground="#B7C9DB" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Grid></Border>
<Border Grid.Row="4" Background="#0B1B2E" BorderBrush="#16476A" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,10"><Grid><TextBlock x:Name="SummaryText" Text="Choose folders, then Preview organization. Nothing will be moved during preview." Foreground="#D6E2F0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource Primary}" Content="1 · Preview" ToolTip="Scan and show exactly what RED RAM plans to do. No files are changed." Click="Preview_Click"/><Button x:Name="RunButton" Style="{StaticResource Primary}" Content="2 · Start organizing" ToolTip="Start moving or copying the files shown in the preview." IsEnabled="False" Click="Run_Click"/><Button x:Name="UndoButton" Content="Undo last move" ToolTip="Move files from the last Move operation back to their original locations." IsEnabled="False" Click="Undo_Click"/><Button Content="Stop" ToolTip="Stop the current preview or organization operation safely." Click="Stop_Click"/></StackPanel></Grid></Border>
<DataGrid x:Name="PreviewGrid" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" Background="#0D1D31" Foreground="White" RowBackground="#0D1D31" AlternatingRowBackground="#10233A" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="90"/><DataGridTextColumn Header="Date used" Binding="{Binding Date,StringFormat=d}" Width="100"/><DataGridTextColumn Header="Device/source" Binding="{Binding Device}" Width="120"/><DataGridTextColumn Header="Will go to" Binding="{Binding Destination}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Note}" Width="210"/></DataGrid.Columns></DataGrid>
<Grid Grid.Row="6" Margin="0,12,0,0"><ProgressBar x:Name="Progress" Height="9" Minimum="0" Maximum="100"/><TextBlock x:Name="StatusText" Foreground="#9AB0C9" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/></Grid>
</Grid></Window>